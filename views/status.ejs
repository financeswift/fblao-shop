<%- include('partials/head') %>

<div class="card narrow">
  <h2>Order Status / 订单查询</h2>
  <p class="muted">Enter your Telegram username and order number to check your order status and view delivered product details after payment. / 输入电报用户名和订单号即可查询订单状态，并在付款后查看发货内容。</p>
  <form method="POST" action="/status" class="stack">
    <label class="field">
      <span>Telegram Username / 电报用户名</span>
      <input type="text" name="telegram_username" required placeholder="@username" value="<%= user ? user.username : '' %>">
    </label>
    <label class="field">
      <span>Order number / 订单号</span>
      <input type="text" name="order_number" required placeholder="LK-XXXXXXXX">
    </label>

    <% if (settings.cf_turnstile_site_key) { %>
      <div style="margin: 10px 0; display: flex; justify-content: center;">
        <div class="cf-turnstile" data-sitekey="<%= settings.cf_turnstile_site_key %>"></div>
      </div>
    <% } %>

    <button type="submit" class="btn btn-primary">Check status / 查询订单</button>
  </form>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (order) { %>
    <hr>
    <div style="text-align: center; margin-bottom: 20px; display: flex; flex-direction: column; align-items: center; gap: 10px;">
        <div class="status-pill status-<%= order.status %>" style="font-size: 1.2rem; padding: 8px 24px; margin:0;"><%= order.status.toUpperCase() %></div>
        <% if (user && user.username === order.telegram_username) { %>
          <a href="/account" class="btn btn-sm btn-light">← Back to My Orders</a>
        <% } %>
    </div>

    <div class="subpanel" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 8px; overflow: hidden;">
        <table class="kv" style="margin: 0;">
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Order Number</th>
            <td style="padding: 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <strong style="flex: 1; min-width: 100px;"><%= order.order_number %></strong>
              <button class="btn btn-sm" style="padding: 4px 8px; font-size: 10px; white-space: nowrap;" onclick="copyStatusVal('<%= order.order_number %>', this)">Copy</button>
            </td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Account Ordered</th>
            <td style="padding: 12px;"><%= order.acc_ordered || order.product_name %></td>
          </tr>
          <% if (order.acc_username) { %>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Username</th>
            <td style="padding: 12px;">
              <code id="val-user"><%= order.acc_username %></code>
              <button class="btn btn-sm" style="padding: 2px 6px; font-size: 10px; margin-left: 10px;" onclick="copyStatusVal('<%= order.acc_username %>', this)">Copy</button>
            </td>
          </tr>
          <% } %>
          <% if (order.acc_password) { %>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Password</th>
            <td style="padding: 12px;">
              <code id="val-pass"><%= order.acc_password %></code>
              <button class="btn btn-sm" style="padding: 2px 6px; font-size: 10px; margin-left: 10px;" onclick="copyStatusVal('<%= order.acc_password %>', this)">Copy</button>
            </td>
          </tr>
          <% } %>
          <% if (order.acc_number || order.acc_name) { %>
            <% if (order.acc_number) { %>
            <tr style="border-bottom: 1px solid var(--border);">
              <th style="padding: 12px; background: rgba(255,255,255,0.02);">Account ID</th>
              <td style="padding: 12px;"><%= order.acc_number %></td>
            </tr>
            <% } %>
            <% if (order.acc_name) { %>
            <tr style="border-bottom: 1px solid var(--border);">
              <th style="padding: 12px; background: rgba(255,255,255,0.02);">Display Name</th>
              <td style="padding: 12px;"><%= order.acc_name %></td>
            </tr>
            <% } %>
          <% } %>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Warranty Period</th>
            <td style="padding: 12px;"><span style="color: var(--accent); font-weight: bold;"><%= order.warranty_period || 'Standard' %></span></td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Placed On</th>
            <td style="padding: 12px;"><%= date(order.created_at) %></td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Payment Method</th>
            <td style="padding: 12px;">
               <span class="payment-inline">
               <% var icon = getIcon(order.payment_type) || (manualMethod ? getIcon(manualMethod.name, manualMethod.icon_url) : null); %>
               <% if (icon) { %>
                 <img class="payment-inline-logo" src="<%= icon %>" alt="Icon">
               <% } %>
               <span style="text-transform: uppercase; font-size: 11px; font-weight: bold;"><%= order.payment_type %></span>
               <%= manualMethod ? ' — ' + manualMethod.name : '' %>
               </span>
            </td>
          </tr>
          <% if (order.sim_type_selected) { %>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">SIM Type</th>
            <td style="padding: 12px;">
              <span style="display:inline-block; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; color:white; background: <%= order.sim_type_selected === 'eSIM' ? '#7c3aed' : '#2563eb' %>;">
                <%= order.sim_type_selected === 'eSIM' ? 'eSIM' : 'Physical SIM' %>
              </span>
            </td>
          </tr>
          <% } %>
          <% if (order.delivery_address) { %>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Delivery Address</th>
            <td style="padding: 12px; white-space: pre-wrap; word-break: break-word; line-height: 1.5;"><%= order.delivery_address %></td>
          </tr>
          <% } %>
          <tr>
            <th style="padding: 12px; background: rgba(255,255,255,0.02);">Total Paid</th>
            <td style="padding: 12px;"><strong><%= money(order.total) %></strong></td>
          </tr>
        </table>
    </div>

    <% if (order.status === 'pending' && order.payment_type === 'manual' && manualMethod) { %>
      <div class="instructions">
        <h3>Payment instructions — <%= manualMethod.name %></h3>
        <div class="instructions-body"><%- nl2br(manualMethod.instructions) %></div>
        <p class="ref-note">Reference: <strong><%= order.order_number %></strong></p>
      </div>
    <% } %>

    <% if (order.status === 'delivered' && order.delivered_content) { %>
      <% 
        const deliveryText = order.delivered_content || '';
        const esimQrMatch = deliveryText.match(/eSIM QR Code:\s*([A-Za-z0-9+/=\r\n]+)/i);
        const esimQrData = esimQrMatch ? esimQrMatch[1].replace(/\s+/g, '') : '';
      %>
      <div class="delivery">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <h3 style="margin:0;">Your delivery credentials</h3>
          <button class="btn btn-sm" onclick="copyStatusVal(document.getElementById('delivery-content').innerText, this)">Copy All</button>
        </div>
        <% if (esimQrData) { %>
          <div style="margin-bottom: 18px; padding: 18px; border: 1px solid rgba(124,58,237,0.45); border-radius: 12px; background: linear-gradient(135deg, rgba(124,58,237,0.12), rgba(37,99,235,0.06)); box-shadow: 0 8px 24px rgba(124,58,237,0.08);">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 12px; font-weight: 700;">eSIM QR Code</div>
            <div style="display: flex; gap: 18px; align-items: center; flex-wrap: wrap;">
              <img src="data:image/png;base64,<%= esimQrData %>" alt="eSIM QR Code" style="max-width: 180px; width: 100%; height: auto; display: block; border-radius: 12px; border: 1px solid var(--border); background: white; padding: 10px;">
              <div style="flex: 1; min-width: 180px;">
                <div style="font-size: 13px; color: var(--text); margin-bottom: 10px; line-height: 1.5;">Scan this QR code in your phone’s eSIM settings to activate the digital SIM immediately.</div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                  <a class="btn btn-sm btn-primary" href="data:image/png;base64,<%= esimQrData %>" download="esim-qr.png">Download QR</a>
                  <button class="btn btn-sm btn-light" type="button" onclick="copyStatusVal(document.getElementById('delivery-content').innerText, this)">Copy details</button>
                </div>
              </div>
            </div>
          </div>
        <% } %>
        <p class="ref-note">Your product is shown below and stays available on this page when you look up the same Telegram username and order number again. / 您的商品内容显示在下方，之后再次使用相同的电报用户名和订单号查询时，仍可在此页面查看。</p>
        <pre class="delivery-body" id="delivery-content"><%= order.delivered_content %></pre>
      </div>
    <% } else if (order.status === 'paid') { %>
      <div class="alert alert-ok" style="margin-top: 20px; text-align: center;">
        <strong>Payment confirmed!</strong> Your account is being prepared and will be displayed here soon. / 付款已确认，商品内容将很快显示在这里。
      </div>
    <% } %>
  <% } %>
</div>

<script>
function copyStatusVal(val, btn) {
  navigator.clipboard.writeText(val).then(() => {
    const oldText = btn.innerText;
    btn.innerText = 'Copied!';
    setTimeout(() => {
      btn.innerText = oldText;
    }, 1500);
  });
}
</script>

<%- include('partials/foot') %>
