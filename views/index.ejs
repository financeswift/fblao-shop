<%- include('partials/head') %>

<!-- Instructions Modal -->
<div class="instructions-overlay" id="instructionsModal">
  <div class="instructions-modal">
    <button class="instructions-close" id="instructionsClose" aria-label="Close">&times;</button>
    <div class="instructions-content">
      <h2>欢迎来到BM店铺</h2>
      <p class="instructions-subtitle">优质账户和数字产品</p>
      
      <div class="instructions-section">
        <h3>📋 如何购买</h3>
        <ol class="instructions-list">
          <li>浏览我们的商品分类（Facebook、Twitter、YouTube、TikTok、Apple ID等）</li>
          <li>点击任何商品上的"立即购买"打开购买表单</li>
          <li>输入您的电报用户名用于订单发货</li>
          <li>选择数量并选择支付方式</li>
          <li>完成支付后通过电报接收您的账户详情</li>
        </ol>
      </div>

      <div class="instructions-section">
        <h3>💳 支付方式</h3>
        <ul class="instructions-list">
          <li>支付宝 (Alipay) - 快速安全</li>
          <li>微信支付 (WeChat Pay) - 中国流行支付方式</li>
          <li>其他数字支付选项可用</li>
        </ul>
      </div>

      <div class="instructions-section">
        <h3>✅ 您将获得</h3>
        <ul class="instructions-list">
          <li>真实可用的账户，包含完整的登录凭证</li>
          <li>账户年龄、粉丝数量和认证状态</li>
          <li>提供邮箱和密码以获得完全账户控制权</li>
          <li>付款确认后即时发货</li>
        </ul>
      </div>

      <div class="instructions-section">
        <h3>🔍 购买后</h3>
        <ul class="instructions-list">
          <li>使用"订单查询"页面随时检查您的发货状态</li>
          <li>输入电报用户名和订单号进行查询</li>
          <li>完成交易后您的账户详情将显示在此页面</li>
        </ul>
      </div>

      <div class="instructions-section">
        <h3>📞 客服支持</h3>
        <p>如有任何问题，请通过电报联系我们。我们的团队24/7在线为您服务。</p>
      </div>

      <button type="button" class="btn btn-block" id="instructionsConfirm">好的，开始购物！</button>
    </div>
  </div>
</div>

<section class="store-hero card">
  <div>
    <h1>一手自运营优质账户 | BM商店</h1>
    <p class="store-hero-copy">精选优质账户，快速结账，专业支付方式，确保每笔交易安全无忧。</p>
  </div>
  <div class="store-hero-chips">
    <span class="hero-chip">Live stock / 实时库存</span>
    <span class="hero-chip">Order lookup / 订单查询</span>
    <% if (magpieEnabled) { %>
      <span class="hero-chip">Alipay 支付宝</span>
      <span class="hero-chip">WeChat Pay 微信支付</span>
    <% } %>
  </div>
</section>

<% if (banners && banners.length) { %>
  <div class="banner-strip">
    <% banners.forEach(function(b){ %>
      <div class="banner"><%= b.text %></div>
    <% }) %>
  </div>
<% } %>

<% if (!catalog.length) { %>
  <div class="empty-state">暂无商品。店铺管理员可以在<a href="/admin">管理面板</a>中添加商品。</div>
<% } %>

<% if (catalog.length) { %>
  <section class="catalog-filters card">
    <div class="catalog-filters-header">
      <div>
        <h2>浏览商品</h2>
        <p class="muted">按商品名称、描述或分类搜索，然后按价格和库存进行筛选。</p>
      </div>
      <button type="button" class="btn btn-sm" id="catalogFilterClear">清除筛选</button>
    </div>

    <form class="catalog-filter-grid" id="catalogFilters" autocomplete="off">
      <label class="field">
        <span>搜索</span>
        <input type="text" id="catalogSearch" placeholder="搜索商品或分类">
      </label>
      <label class="field">
        <span>最低价</span>
        <input type="number" id="catalogMinPrice" min="0" step="0.01" placeholder="0.00">
      </label>
      <label class="field">
        <span>最高价</span>
        <input type="number" id="catalogMaxPrice" min="0" step="0.01" placeholder="9999.00">
      </label>
      <label class="catalog-checkbox">
        <input type="checkbox" id="catalogInStock">
        <span>仅看有货</span>
      </label>
    </form>

    <div class="catalog-filter-summary" id="catalogFilterSummary">
      共显示 <strong>*</strong> 件商品
    </div>
  </section>

  <div class="empty-state" id="catalogFilterEmpty" hidden>当前筛选下暂无商品。</div>
<% } %>

<% catalog.forEach(function(cat){ %>
  <section class="category-block" data-category-block data-category-name="<%= cat.name.toLowerCase() %>">
    <h2 class="category-title">
      <span><%= cat.name %></span>
      <span class="muted" style="font-size: 11px; font-weight: normal; text-transform: uppercase; letter-spacing: 0.05em;"><%= cat.products.length %> 件商品</span>
    </h2>
    <div class="table-wrap">
      <table class="product-table">
        <thead>
          <tr>
            <th class="col-name">商品</th>
            <th class="col-price">价格</th>
            <th class="col-stock">库存</th>
            <th class="col-buy"></th>
          </tr>
        </thead>
        <tbody>
          <% cat.products.forEach(function(p){ %>
            <tr
              data-product-row
              data-name="<%= (p.name || '').toLowerCase() %>"
              data-description="<%= (p.description || '').toLowerCase() %>"
              data-category="<%= (cat.name || '').toLowerCase() %>"
              data-price="<%= p.price %>"
              data-stock="<%= p.stock %>">
              <td class="col-name">
                <div class="product-badges">
                  <% if (p.stock > 50) { %>
                    <span class="badge badge-new">New</span>
                  <% } %>
                  <% if (p.stock > 20 && p.stock <= 50) { %>
                    <span class="badge badge-hot">Hot</span>
                  <% } %>
                  <% if (p.stock > 0 && p.stock <= 10) { %>
                    <span class="badge badge-limited">Limited</span>
                  <% } %>
                </div>
                <div class="p-name"><%= p.name %></div>
                <% if (p.description) { %><div class="p-desc"><%= p.description %></div><% } %>
                <% if (p.stock > 0 && p.stock <= 5) { %>
                  <div class="stock-warning">⚠️ 仅剩<strong><%= p.stock %></strong>个</div>
                <% } %>
              </td>
              <td class="col-price">
                <div><%= money(p.price) %></div>
                <div class="stock-count">库存: <strong><%= p.stock %></strong></div>
              </td>
              <td class="col-stock">
                <% if (p.stock > 0) { %>
                  <span class="stock-ok">✓ 有货</span>
                <% } else { %>
                  <span class="stock-out">已售完</span>
                <% } %>
              </td>
              <td class="col-buy">
                <% if (p.stock > 0) { %>
                  <button class="btn btn-buy"
                          data-id="<%= p.id %>"
                          data-name="<%= escapeHtml(p.name) %>"
                          data-price="<%= p.price %>"
                          data-stock="<%= p.stock %>"
                          data-min="<%= p.min_quantity || 1 %>"
                          data-is-rentable="<%= p.is_rentable || 0 %>"
                          data-rental-1d="<%= p.rental_1day_price || 0 %>"
                          data-rental-7d="<%= p.rental_7day_price || 0 %>"
                          data-rental-30d="<%= p.rental_30day_price || 0 %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    立即购买
                  </button>
                <% } else { %>
                  <button class="btn btn-disabled" disabled>已售完</button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% }) %>

<!-- Purchase modal -->
<div class="modal-overlay" id="buyModal">
  <div class="modal">
    <button class="modal-close" id="modalClose" aria-label="Close">&times;</button>
    <h3 class="modal-title"><span id="m-product"></span></h3>
    
    <!-- Buy/Rent toggle -->
    <div class="product-type-selector">
      <div class="type-toggle">
        <button type="button" class="type-option active" data-type="buy" id="typeOptionBuy">购买</button>
        <button type="button" class="type-option" data-type="rent" id="typeOptionRent">租赁</button>
      </div>
    </div>
    
    <form method="POST" action="/order" id="buyForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="product_id" id="m-product-id">
      <input type="hidden" name="payment_type" id="m-payment-type">
      <input type="hidden" name="manual_method_id" id="m-manual-id">
      <input type="hidden" name="order_type" id="m-order-type" value="buy">
      <input type="hidden" name="rental_days" id="m-rental-days" value="0">

      <!-- Rental Period Selector -->
      <div class="rental-period-selector" id="rentalPeriodSection">
        <label class="rental-period-label">选择租赁期</label>
        <div class="rental-periods">
          <button type="button" class="rental-period-btn active" data-days="1" data-price="0">
            1 天
            <small id="rental-price-1d"></small>
          </button>
          <button type="button" class="rental-period-btn" data-days="7" data-price="0">
            7 天
            <small id="rental-price-7d"></small>
          </button>
          <button type="button" class="rental-period-btn" data-days="30" data-price="0">
            30 天
            <small id="rental-price-30d"></small>
          </button>
        </div>
      </div>

      <label class="field">
        <span>电报用户名</span>
        <input type="text" name="telegram_username" id="m-telegram" required placeholder="@username" value="<%= user ? user.username : '' %>">
        <small class="muted">您的订单详情和发货内容将绑定到此用户名</small>
      </label>

      <div class="field-row">
        <label class="field">
          <span>数量</span>
          <input type="number" name="quantity" id="m-qty" value="1" min="1" required>
        </label>
        <div class="field">
          <span>单价</span>
          <div class="readout" id="m-unit"></div>
        </div>
        <div class="field">
          <span>合计</span>
          <div class="readout total" id="m-total"></div>
        </div>
      </div>

      <!-- SIM Type Selector (if product has SIM/eSIM accounts) -->
      <div id="simTypeSection" style="display: none;">
        <label class="field">
          <span>配送类型</span>
          <select name="sim_type_selected" id="m-sim-type" style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; background: var(--panel);" required>
            <option value="">-- 选择SIM类型 --</option>
            <option value="SIM">SIM卡（需填收货地址）</option>
            <option value="eSIM">eSIM（数字即时）</option>
          </select>
        </label>
      </div>

      <!-- Delivery Address (shown only when SIM type is selected as "SIM") -->
      <div id="deliveryAddressSection" style="display: none;">
        <label class="field">
          <span>收货地址</span>
          <textarea name="delivery_address" id="m-delivery-address" style="width: 100%; min-height: 80px; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; background: var(--panel); font-family: system-ui, -apple-system, sans-serif; resize: vertical;" placeholder="完整收货地址"></textarea>
          <small class="muted">您的物理地址，SIM卡将被送达此地址</small>
        </label>
      </div>

      <!-- Payment method picker -->
      <div class="pay-method-picker">
        <p class="pay-method-picker-label">选择支付方式</p>

        <% if (swiftpayEnabled) { %>
          <%# SwiftPay e-Wallet Methods (Direct payment, similar to how Maya works) %>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_maya">
            <img class="pay-method-logo" src="<%= getIcon('maya') %>" alt="Maya">
            <span class="pay-method-info">
              <strong>Maya</strong>
              <small>使用Maya钱包支付</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <%# GCash Wallet Method %>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_gcash">
            <img class="pay-method-logo" src="/static/img/footer-logos/gcash@selection.png" alt="GCash">
            <span class="pay-method-info">
              <strong>GCash</strong>
              <small>Send money via GCash app / 用 GCash 发送</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <%# QRPH (InstaPay / PESONet) — shows QR code inline, user scans to complete payment %>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_qrph">
            <span class="pay-method-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><path d="M14 14h.01M14 17h.01M17 14h.01M17 17h4v4h-4z"></path></svg>
            </span>
            <span class="pay-method-info">
              <strong>QRPH</strong>
              <small>扫码支付</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          
          <%# Philippine Banks — Online banking login & transfer (work same as Maya) %>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_bpi">
            <img class="pay-method-logo" src="<%= getIcon('bpi') %>" alt="BPI">
            <span class="pay-method-info">
              <strong>BPI</strong>
              <small>Bank of the Philippine Islands / BPI Online</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_bpi_fsb">
            <img class="pay-method-logo" src="<%= getIcon('bpi-fsb') %>" alt="BPI FSB">
            <span class="pay-method-info">
              <strong>BPI Family Savings Bank</strong>
              <small>BSP-Supervised Bank</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_bdo">
            <img class="pay-method-logo" src="<%= getIcon('bdo') %>" alt="BDO">
            <span class="pay-method-info">
              <strong>BDO</strong>
              <small>Banco de Oro / BDO Online</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_unionbank">
            <img class="pay-method-logo" src="<%= getIcon('unionbank') %>" alt="UnionBank">
            <span class="pay-method-info">
              <strong>UnionBank</strong>
              <small>Union Bank of the Philippines / UB Online</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_metrobank">
            <img class="pay-method-logo" src="<%= getIcon('metrobank') %>" alt="Metrobank">
            <span class="pay-method-info">
              <strong>Metrobank</strong>
              <small>Metropolitan Bank and Trust Company</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_landbank">
            <img class="pay-method-logo" src="<%= getIcon('landbank') %>" alt="LandBank">
            <span class="pay-method-info">
              <strong>LandBank</strong>
              <small>Land Bank of the Philippines</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_rcbc">
            <img class="pay-method-logo" src="<%= getIcon('rcbc') %>" alt="RCBC">
            <span class="pay-method-info">
              <strong>RCBC</strong>
              <small>Rizal Commercial Banking Corporation / RCBC Online</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_netbank">
            <img class="pay-method-logo" src="<%= getIcon('netbank') %>" alt="NetBank">
            <span class="pay-method-info">
              <strong>NetBank</strong>
              <small>NetBank在线支付</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="swiftpay_vbank">
            <img class="pay-method-logo" src="<%= getIcon('vbank') %>" alt="VBank">
            <span class="pay-method-info">
              <strong>Virtual Bank</strong>
              <small>VBank在线支付</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        <% } %>

        <% if (magpieEnabled) { %>
          <button type="button" class="pay-method-btn" data-pay="magpie_alipay">
            <img class="pay-method-logo" src="/static/img/footer-logos/alipay.svg" alt="Alipay">
            <span class="pay-method-info">
              <strong>Alipay 支付宝</strong>
              <small>Auto-converted to CNY / 自动换算人民币</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="pay-method-btn" data-pay="magpie_wechat">
            <img class="pay-method-logo" src="/static/img/footer-logos/wechat.svg" alt="WeChat Pay">
            <span class="pay-method-info">
              <strong>WeChat Pay 微信支付</strong>
              <small>Auto-converted to CNY / 自动换算人民币</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        <% } %>

        <%# Legacy gateway options (only shown if SwiftPay is not configured) %>
        <% if (!swiftpayEnabled && mayaEnabled) { %>
          <button type="button" class="pay-method-btn" data-pay="maya">
            <img class="pay-method-logo" src="<%= getIcon('maya') %>" alt="Maya">
            <span class="pay-method-info">
              <strong>Maya Checkout</strong>
              <small>Pay with Maya, GCash, or Card</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        <% } %>
        <% if (coinsEnabled) { %>
          <button type="button" class="pay-method-btn" data-pay="coins">
            <img class="pay-method-logo" src="<%= getIcon('coins.ph') %>" alt="Coins.ph">
            <span class="pay-method-info">
              <strong>Coins.ph</strong>
              <small>Instant Crypto/Wallet payment</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        <% } %>
        <% if (paymongoEnabled) { %>
          <button type="button" class="pay-method-btn" data-pay="paymongo">
            <img class="pay-method-logo" src="<%= getIcon('paymongo') %>" alt="PayMongo">
            <span class="pay-method-info">
              <strong>PayMongo</strong>
              <small>GCash, Maya, Cards, BillEase</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        <% } %>
        <% if (xenditEnabled) { %>
          <button type="button" class="pay-method-btn" data-pay="xendit">
            <img class="pay-method-logo" src="<%= getIcon('xendit') %>" alt="Xendit">
            <span class="pay-method-info">
              <strong>Xendit</strong>
              <small>PH/ID Local Payments</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        <% } %>

        <% manualMethods.forEach(function(m){ %>
          <button type="button" class="pay-method-btn" data-pay="manual" data-manual="<%= m.id %>">
            <% var icon = getIcon(m.name, m.icon_url); %>
            <% if (icon) { %>
              <img class="pay-method-logo" src="<%= icon %>" alt="<%= m.name %>">
            <% } else { %>
              <span class="pay-method-icon-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
              </span>
            <% } %>
            <span class="pay-method-info">
              <strong><%= m.name %></strong>
              <small>Manual transfer / 手动转账</small>
            </span>
            <svg class="pay-method-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        <% }) %>

        <% if (!swiftpayEnabled && !magpieEnabled && !mayaEnabled && !coinsEnabled && !paymongoEnabled && !xenditEnabled && !manualMethods.length) { %>
          <p class="muted" style="text-align:center; padding: 16px 0;">No payment methods are configured yet.</p>
        <% } %>
      </div>

      <% if (settings.cf_turnstile_site_key) { %>
        <div class="field" style="margin-top: 15px; display: flex; justify-content: center;">
          <div class="cf-turnstile" data-sitekey="<%= settings.cf_turnstile_site_key %>"></div>
        </div>
      <% } %>
    </form>
  </div>
</div>

<%- include('partials/foot') %>

<script>
// Instructions Modal Handler
(function() {
  const overlay = document.getElementById('instructionsModal');
  const closeBtn = document.getElementById('instructionsClose');
  const confirmBtn = document.getElementById('instructionsConfirm');
  const storageKey = 'bm-shop-instructions-seen';

  function closeInstructions() {
    overlay.classList.remove('is-open');
    localStorage.setItem(storageKey, 'true');
  }

  function openInstructions() {
    overlay.classList.add('is-open');
  }

  // Show instructions on every page visit
  setTimeout(() => {
    openInstructions();
  }, 300);

  closeBtn.addEventListener('click', closeInstructions);
  confirmBtn.addEventListener('click', closeInstructions);

  // Close on overlay click
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) {
      closeInstructions();
    }
  });
})();

// Rental Account Feature Handler
(function() {
  const typeOptionBuy = document.getElementById('typeOptionBuy');
  const typeOptionRent = document.getElementById('typeOptionRent');
  const rentalPeriodSection = document.getElementById('rentalPeriodSection');
  const orderTypeField = document.getElementById('m-order-type');
  const rentalDaysField = document.getElementById('m-rental-days');
  const rentalPeriodBtns = document.querySelectorAll('.rental-period-btn');
  
  let currentProduct = { rental_1day_price: 0, rental_7day_price: 0, rental_30day_price: 0, is_rentable: 0 };

  // Store product data when modal opens
  const originalShowModal = window.showBuyModal || (() => {});
  window.showBuyModal = function(id, name, price, stock, minQty, rental1d, rental7d, rental30d, isRentable) {
    document.getElementById('m-product').textContent = name;
    document.getElementById('m-product-id').value = id;
    document.getElementById('m-unit').textContent = window.money ? window.money(price) : '$' + price;
    document.getElementById('m-qty').value = minQty || 1;
    document.getElementById('m-stock').textContent = stock;
    
    // Store rental prices
    currentProduct = {
      id: id,
      name: name,
      price: price,
      rental_1day_price: rental1d || 0,
      rental_7day_price: rental7d || 0,
      rental_30day_price: rental30d || 0,
      is_rentable: isRentable ? 1 : 0
    };

    // Update rental prices display
    if (isRentable) {
      document.getElementById('rental-price-1d').textContent = rental1d ? window.money ? window.money(rental1d) : '$' + rental1d : '—';
      document.getElementById('rental-price-7d').textContent = rental7d ? window.money ? window.money(rental7d) : '$' + rental7d : '—';
      document.getElementById('rental-price-30d').textContent = rental30d ? window.money ? window.money(rental30d) : '$' + rental30d : '—';
      typeOptionRent.disabled = false;
      typeOptionRent.style.opacity = '1';
    } else {
      typeOptionBuy.click();
      typeOptionRent.disabled = true;
      typeOptionRent.style.opacity = '0.5';
    }

    document.getElementById('buyModal').classList.add('is-open');
    updateTotal();
  };

  // Toggle between Buy and Rent
  typeOptionBuy.addEventListener('click', function() {
    typeOptionBuy.classList.add('active');
    typeOptionRent.classList.remove('active');
    rentalPeriodSection.classList.remove('is-visible');
    orderTypeField.value = 'buy';
    rentalDaysField.value = '0';
    updateTotal();
  });

  typeOptionRent.addEventListener('click', function() {
    if (!currentProduct.is_rentable) return;
    typeOptionRent.classList.add('active');
    typeOptionBuy.classList.remove('active');
    rentalPeriodSection.classList.add('is-visible');
    orderTypeField.value = 'rent';
    // Select first rental period by default
    rentalPeriodBtns[0].click();
  });

  // Rental period selection
  rentalPeriodBtns.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const days = this.dataset.days;
      const price = this.dataset.price;
      
      rentalPeriodBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      rentalDaysField.value = days;
      
      // Get the price based on selected days
      let rentalPrice = 0;
      if (days == 1) rentalPrice = currentProduct.rental_1day_price;
      else if (days == 7) rentalPrice = currentProduct.rental_7day_price;
      else if (days == 30) rentalPrice = currentProduct.rental_30day_price;
      
      // Update total
      const qty = parseInt(document.getElementById('m-qty').value) || 1;
      const total = rentalPrice * qty;
      document.getElementById('m-total').textContent = window.money ? window.money(total) : '$' + total;
    });
  });
})();
</script>
