<%- include('partials/head') %>

<div class="qrph-qr-page">
  <div class="qrph-qr-header">
    <div class="qrph-qr-logo-wrap">
      <img class="qrph-qr-logo" src="/static/img/footer-logos/qrph.svg" alt="QRPH">
    </div>
  </div>

  <div class="qrph-qr-content">
    <% if (order.status === 'paid' || order.status === 'delivered') { %>
      <div class="alert alert-success">Payment confirmed! Your order is being processed.</div>
      <a class="btn btn-primary" href="/status?ref=<%= encodeURIComponent(order.order_number) %>&tg=<%= encodeURIComponent(order.telegram_username) %>">View order status</a>
    <% } else if (order.status === 'failed') { %>
      <div class="alert alert-error">Payment failed or expired. Please start a new order.</div>
    <% } else { %>
      <% if (paymentId) { %>
        <div class="qrph-qr-card">
          <p class="qrph-qr-title">Scan this QR code with any InstaPay or PESONet app to complete payment.</p>

          <div class="qrph-qr-box">
            <img
              id="qrph-img"
              class="qrph-qr-image"
              src="/swiftpay/qrph/image?paymentId=<%= encodeURIComponent(paymentId) %>"
              alt="QRPH QR Payment Code"
              onerror="document.getElementById('qrph-fallback').style.display='block';this.style.display='none';"
            >
          </div>

          <div id="qrph-fallback" class="alert alert-error" style="display:none; margin-top: 12px;">
            QR image could not be loaded. Please use any InstaPay or PESONet app to scan and complete payment.
          </div>

          <p class="qrph-qr-amount">Pay <strong><%= money(order.total) %></strong> via QRPH</p>

          <div class="qrph-qr-actions">
            <a class="qrph-status-btn" href="/status?ref=<%= encodeURIComponent(order.order_number) %>&tg=<%= encodeURIComponent(order.telegram_username) %>">Check status</a>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-error">QR code is unavailable. Please contact support with your order number.</div>
      <% } %>
    <% } %>
  </div>
</div>

<%- include('partials/foot') %>
