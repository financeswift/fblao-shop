<%- include('partials/head') %>

<div class="card">
  <div class="swiftpay-hero">
    <div>
      <div class="status-pill status-pending">等待支付</div>
      <h2 style="margin: 0 0 8px;">完成Swiftpay支付</h2>
      <p class="muted" style="margin: 0;">在将买家发送到Swiftpay安全支付表单时保持品牌一致。</p>
    </div>
    <img class="swiftpay-badge" src="<%= getIcon('swiftpay') %>" alt="Swiftpay PH">
  </div>

  <div class="swiftpay-layout">
    <div class="subpanel">
      <h3 style="margin-top:0;">订单摘要</h3>
      <table class="kv" style="margin-bottom:0;">
        <tr><th>Order number</th><td><strong><%= order.order_number %></strong></td></tr>
        <tr><th>@</th><td>@<%= order.telegram_username %></td></tr>
        <tr><th>Product</th><td><%= order.product_name %></td></tr>
        <tr><th>Quantity</th><td><%= order.quantity %></td></tr>
        <tr><th>Total</th><td><strong><%= money(order.total) %></strong></td></tr>
      </table>
    </div>

    <div class="subpanel">
      <h3 style="margin-top:0;">下一步</h3>
      <p class="muted">打开安全的Swiftpay结账以完成支付，然后返回此处确认最终状态。</p>

      <% if (checkoutUrl) { %>
        <a class="btn btn-primary btn-block" href="<%= checkoutUrl %>" target="_blank" rel="noopener noreferrer">
          <img class="payment-inline-logo" src="<%= getIcon('swiftpay') %>" alt="Swiftpay PH">
          继续到Swiftpay
        </a>
      <% } else { %>
        <div class="alert alert-error" style="margin-top:0;">此订单的Swiftpay结账链接不可用。请开始新订单。</div>
      <% } %>

      <div class="instructions swiftpay-note">
        <h3>接下来会发生什么</h3>
        <div class="instructions-body">
          1. Complete the payment in Swiftpay.<br>
          2. Return to the status page for live confirmation.<br>
          3. Once paid, your order will move forward automatically.
        </div>
      </div>

      <div class="actions">
        <a class="btn" href="/swiftpay/status?ref=<%= encodeURIComponent(order.order_number) %>">我已经支付</a>
        <a class="btn btn-light" href="/status?ref=<%= encodeURIComponent(order.order_number) %>&tg=<%= encodeURIComponent(order.telegram_username) %>">打开常规状态</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
