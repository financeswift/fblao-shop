<%- include('partials/head') %>

<div class="admin-layout">
  <%- include('partials/sidebar') %>

  <main class="admin-content">
    <div class="admin-header">
      <h1>Payment Channel Integration</h1>
      <p class="muted">Manage API keys and connection details for payment channels. Credentials are automatically sent to customers after they purchase a payment code.</p>
    </div>

    <!-- Enhancement Features Menu -->
    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
      <strong style="width: 100%; margin-bottom: 10px;">🔧 Enhancement Features:</strong>
      <a href="/admin/payment-channels/analytics" class="btn btn-sm btn-outline-primary" title="View payment channel analytics and performance">📊 Analytics</a>
      <a href="/admin/payment-channels/history" class="btn btn-sm btn-outline-info" title="View customer payment channel connections">📜 Connection History</a>
      <a href="/admin/payment-channels/webhooks" class="btn btn-sm btn-outline-warning" title="View incoming webhook logs">🔌 Webhook Logs</a>
    </div>

    <% if (flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %>">
        <%= flash.msg %>
      </div>
    <% } %>

    <% if (paymentChannelProducts.length === 0) { %>
      <div class="empty-state">
        <p>No payment channel products found. Create products in "Philippine Payment Code", "THAI Payment Code", or "Vietnam Payment Code" categories first.</p>
        <a href="/admin/products" class="btn btn-primary">Manage Products</a>
      </div>
    <% } else { %>
      <div class="payment-channels-grid">
        <% paymentChannelProducts.forEach(function(product) { %>
          <% const creds = credentials[product.id]; %>
          <div class="payment-channel-card card">
            <div class="card-header">
              <div>
                <h3><%= product.name %></h3>
                <p class="muted" style="font-size: 12px; margin-top: 4px;"><%= product.category_name %></p>
              </div>
              <div class="badge" style="<%= creds && creds.enabled ? 'background: #2ecc71; color: white;' : 'background: #e74c3c; color: white;' %>">
                <%= creds && creds.enabled ? '✓ Configured' : '⚠ Not Configured' %>
              </div>
            </div>

            <form method="POST" action="/admin/payment-channels/<%= product.id %>/save" class="payment-channel-form">
              <div class="form-group">
                <label>Channel Name</label>
                <input type="text" name="channel_name" value="<%= creds ? creds.channel_name : product.name %>" placeholder="e.g., PromptPay, Momo Wallet" class="form-control">
                <small class="muted">Display name for the payment channel</small>
              </div>

              <div class="form-group">
                <label>Connection URL / Dashboard</label>
                <input type="url" name="connection_url" value="<%= creds ? creds.connection_url : '' %>" placeholder="https://api.example.com/connect" class="form-control">
                <small class="muted">Link where customers connect their accounts</small>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label>API Key</label>
                  <input type="text" name="api_key" value="<%= creds ? creds.api_key : '' %>" placeholder="Your API key" class="form-control" style="font-family: monospace; font-size: 12px;">
                  <small class="muted">API credentials for integration</small>
                </div>
                <div class="form-group">
                  <label>API Secret</label>
                  <input type="password" name="api_secret" value="<%= creds ? creds.api_secret : '' %>" placeholder="Your API secret" class="form-control" style="font-family: monospace; font-size: 12px;">
                  <small class="muted">Keep this secret and secure</small>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label>Merchant ID / Account Number</label>
                  <input type="text" name="merchant_id" value="<%= creds ? creds.merchant_id : '' %>" placeholder="Merchant ID" class="form-control">
                  <small class="muted">Your merchant identifier</small>
                </div>
                <div class="form-group">
                  <label>Account Number</label>
                  <input type="text" name="account_number" value="<%= creds ? creds.account_number : '' %>" placeholder="e.g., bank account or wallet number" class="form-control">
                  <small class="muted">For receiving payments</small>
                </div>
              </div>

              <div class="form-group">
                <label>Webhook URL (Optional)</label>
                <input type="url" name="webhook_url" value="<%= creds ? creds.webhook_url : '' %>" placeholder="https://yoursite.com/webhook/payment" class="form-control">
                <small class="muted">For receiving payment notifications</small>
              </div>

              <div class="form-group">
                <label>Setup Instructions</label>
                <textarea name="instructions" rows="4" placeholder="Instructions for customers on how to connect their account. Line breaks are preserved." class="form-control"><%= creds ? creds.instructions : '' %></textarea>
                <small class="muted">These instructions will be shown to customers after payment</small>
              </div>

              <div class="form-group">
                <label>
                  <input type="checkbox" name="enabled" <%= (creds && creds.enabled) ? 'checked' : '' %> style="width: 18px; height: 18px; accent-color: var(--accent); margin-right: 8px;">
                  <span>Enabled - Customers can purchase this payment channel</span>
                </label>
              </div>

              <div class="form-actions" style="display: flex; gap: 8px; flex-wrap: wrap;">
                <button type="submit" class="btn btn-primary">💾 Save Credentials</button>
                <% if (creds) { %>
                  <form method="POST" action="/admin/payment-channels/<%= product.id %>/verify" style="display: inline;">
                    <button type="submit" class="btn btn-info" title="Test and verify the API credentials">🔐 Verify</button>
                  </form>
                  <a href="/admin/payment-channels/<%= product.id %>/verification-history" class="btn btn-outline-info" title="View credential verification history">📋 History</a>
                  <form method="POST" action="/admin/payment-channels/<%= product.id %>/delete" style="display: inline;" onsubmit="return confirm('Delete credentials for <%= product.name %>?');">
                    <button type="submit" class="btn btn-danger">🗑 Delete</button>
                  </form>
                <% } %>
              </div>
            </form>

            <% if (creds) { %>
              <div style="background: #f5f5f5; padding: 12px; border-radius: 4px; margin-top: 16px; font-size: 12px;">
                <strong>Last updated:</strong> <%= new Date(creds.updated_at).toLocaleString() %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</div>

<style>
  .payment-channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .payment-channel-card {
    padding: 20px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f0f0f0;
  }

  .card-header h3 {
    margin: 0;
    font-size: 18px;
  }

  .badge {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: bold;
    white-space: nowrap;
  }

  .payment-channel-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-weight: 500;
    font-size: 14px;
  }

  .form-control {
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.1);
  }

  .form-actions {
    margin-top: 12px;
  }

  @media (max-width: 768px) {
    .payment-channels-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<%- include('partials/foot') %>
