<%- include('partials/head') %>
<h1>Settings</h1>

<div class="panel-grid">
  <div class="subpanel">
    <h2>Shop</h2>
    <form method="POST" action="/admin/settings">
      <label class="field"><span>Shop name</span><input type="text" name="shop_name" value="<%= escapeHtml(s.shop_name) %>"></label>
      <label class="field"><span>Tagline</span><input type="text" name="shop_tagline" value="<%= escapeHtml(s.shop_tagline) %>"></label>
      <label class="field"><span>Currency code</span><input type="text" name="currency" value="<%= escapeHtml(s.currency) %>"></label>
      <button class="btn btn-primary" type="submit">Save shop settings</button>
    </form>

    <hr style="margin: 20px 0; border: none; border-top: 1px solid #eee;">

    <form method="POST" action="/admin/settings/logo" enctype="multipart/form-data">
      <label class="field">
        <span>Shop Logo</span>
        <div style="display:flex; align-items:center; gap: 15px; margin-top: 10px;">
          <img src="/logo.png?v=<%= Date.now() %>" alt="Current Logo" style="height: 50px; border: 1px solid var(--border); padding: 4px; border-radius: 4px; background: #fff;">
          <input type="file" name="logo" accept="image/png,image/jpeg,image/gif" required>
        </div>
        <small class="muted">Recommended: Transparent PNG, square or horizontal aspect ratio.</small>
      </label>
      <button class="btn btn-sm" type="submit">Upload New Logo</button>
    </form>
  </div>

  <div class="subpanel">
    <h2>Admin password</h2>
    <form method="POST" action="/admin/settings/password">
      <label class="field"><span>Current password</span><input type="password" name="current_password" required></label>
      <label class="field"><span>New password</span><input type="password" name="new_password" required></label>
      <button class="btn btn-primary" type="submit">Change password</button>
    </form>
  </div>
  <div class="subpanel">
    <h2>Database Management</h2>
    <div style="background: rgba(255,255,255,0.03); padding: 15px; border-radius: 8px; margin-bottom: 15px;">
      <p style="margin-top:0;"><strong>Storage Path:</strong> <code><%= dbInfo.path %></code></p>
      <p><strong>File Size:</strong> <%= dbInfo.size %></p>
      <p><strong>Persistence:</strong>
        <% if (dbInfo.isPersistent) { %>
          <span style="color: var(--green); font-weight: bold;">✓ SECURE (Volume Active)</span>
        <% } else { %>
          <span style="color: var(--red); font-weight: bold;">⚠ TEMPORARY (Data will be lost on redeploy)</span>
        <% } %>
      </p>
    </div>
    <div style="display:flex; flex-direction: column; gap:10px;">
      <a href="/admin/settings/db-download" class="btn btn-sm" style="background:#eee;color:#333;">Download shop.db Backup</a>

      <form method="POST" action="/admin/settings/db-restore" enctype="multipart/form-data" onsubmit="return confirm('WARNING: This will overwrite your entire database. Proceed?');" style="border-top: 1px solid var(--border); padding-top: 15px; margin-top: 5px;">
        <label class="field">
          <span style="color: var(--red); font-weight: bold;">Restore Database (.db file)</span>
          <input type="file" name="db_file" accept=".db" required style="margin-top:5px;">
        </label>
        <button type="submit" class="btn btn-sm btn-danger">Upload & Restore</button>
      </form>
    </div>
    <% if (!dbInfo.isPersistent) { %>
      <div class="alert alert-error" style="margin-top:15px; font-size: 12px;">
        To fix: Create a <strong>Railway Volume</strong> mounted to <code>/data</code> and redeploy.
      </div>
    <% } %>
  </div>
</div>

<div class="panel-grid" style="margin-top:20px;">
  <div class="subpanel">
    <h2>Cloudflare (Security & Verification)</h2>
    <form method="POST" action="/admin/settings/cloudflare">
      <label class="field">
        <span>Cloudflare Site Verification Token</span>
        <input type="text" name="cf_site_verification" value="<%= escapeHtml(s.cf_site_verification) %>" placeholder="cloudflare-site-verification=...">
        <small class="muted">Adds <code>&lt;meta name="cloudflare-site-verification"&gt;</code> to your homepage.</small>
      </label>

      <hr style="margin: 15px 0; border: none; border-top: 1px solid #eee;">

      <h3>Turnstile (Bot Protection)</h3>
      <p class="muted">Protect your order and query forms from bots. Get keys from <a href="https://dash.cloudflare.com/?to=/:account/turnstile" target="_blank">Cloudflare Turnstile</a>.</p>
      <label class="field"><span>Site Key</span><input type="text" name="cf_turnstile_site_key" value="<%= escapeHtml(s.cf_turnstile_site_key) %>"></label>
      <label class="field"><span>Secret Key</span><input type="password" name="cf_turnstile_secret_key" value="<%= escapeHtml(s.cf_turnstile_secret_key) %>"></label>

      <button class="btn btn-primary" type="submit">Save Cloudflare settings</button>
    </form>
  </div>

  <div class="subpanel">
    <h2>Maya Checkout (online card payment)</h2>
    <p class="muted">Get keys from your Maya Business dashboard. Use <strong>sandbox</strong> keys for testing.</p>
    <form method="POST" action="/admin/settings/maya">
      <div class="field-row">
        <label class="field" style="flex:0 0 130px;"><span>Enabled</span><input type="checkbox" name="maya_enabled" <%= s.maya_enabled === '1' ? 'checked' : '' %>></label>
        <label class="field"><span>Mode</span>
          <select name="maya_mode">
            <option value="sandbox" <%= s.maya_mode !== 'live' ? 'selected' : '' %>>Sandbox</option>
            <option value="live" <%= s.maya_mode === 'live' ? 'selected' : '' %>>Live (production)</option>
          </select></label>
      </div>
      <label class="field"><span>Public key (pk-...)</span><input type="text" name="maya_public_key" value="<%= escapeHtml(s.maya_public_key) %>"></label>
      <label class="field"><span>Secret key (sk-...)</span><input type="text" name="maya_secret_key" value="<%= escapeHtml(s.maya_secret_key) %>"></label>
      <label class="field"><span>Webhook secret (optional)</span><input type="text" name="maya_webhook_secret" value="<%= escapeHtml(s.maya_webhook_secret) %>"></label>
      <button class="btn btn-primary" type="submit">Save Maya configuration</button>
    </form>
    <div class="alert alert-ok" style="margin-top:14px; font-size: 11px;">
      <strong>Webhook URL:</strong> <code><%= baseUrl %>/webhooks/maya/payment-status</code>
    </div>
  </div>

  <div class="subpanel">
    <h2>Coins.ph Enterprise (crypto/wallet)</h2>
    <p class="muted">Get keys from your Coins.ph Business Portal. Use <strong>sandbox</strong> for testing.</p>
    <form method="POST" action="/admin/settings/coins">
      <div class="field-row">
        <label class="field" style="flex:0 0 130px;"><span>Enabled</span><input type="checkbox" name="coins_enabled" <%= s.coins_enabled === '1' ? 'checked' : '' %>></label>
        <label class="field"><span>Mode</span>
          <select name="coins_mode">
            <option value="sandbox" <%= s.coins_mode !== 'live' ? 'selected' : '' %>>Sandbox</option>
            <option value="live" <%= s.coins_mode === 'live' ? 'selected' : '' %>>Live (production)</option>
          </select></label>
      </div>
      <label class="field"><span>API Key</span><input type="text" name="coins_api_key" value="<%= escapeHtml(s.coins_api_key) %>"></label>
      <label class="field"><span>API Secret</span><input type="text" name="coins_api_secret" value="<%= escapeHtml(s.coins_api_secret) %>"></label>
      <label class="field"><span>Webhook Secret</span><input type="text" name="coins_webhook_secret" value="<%= escapeHtml(s.coins_webhook_secret) %>"></label>
      <button class="btn btn-primary" type="submit">Save Coins.ph configuration</button>
    </form>
    <div class="alert alert-ok" style="margin-top:14px; font-size: 11px;">
      <strong>Webhook URL:</strong> <code><%= baseUrl %>/webhooks/coins/payment-status</code>
    </div>
  </div>

  <div class="subpanel">
    <h2>PayMongo (Cards, GCash, Maya)</h2>
    <p class="muted">Enter your Secret Key from PayMongo Dashboard.</p>
    <form method="POST" action="/admin/settings/paymongo">
      <label class="field" style="flex:0 0 130px;"><span>Enabled</span><input type="checkbox" name="paymongo_enabled" <%= s.paymongo_enabled === '1' ? 'checked' : '' %>></label>
      <label class="field"><span>Secret Key (sk_...)</span><input type="text" name="paymongo_secret_key" value="<%= escapeHtml(s.paymongo_secret_key) %>"></label>
      <label class="field"><span>Webhook Secret (whsec_...)</span><input type="text" name="paymongo_webhook_secret" value="<%= escapeHtml(s.paymongo_webhook_secret) %>"></label>
      <button class="btn btn-primary" type="submit">Save PayMongo configuration</button>
    </form>
    <div class="alert alert-ok" style="margin-top:14px; font-size: 11px;">
      <strong>Webhook URL:</strong> <code><%= baseUrl %>/webhooks/paymongo</code>
    </div>
  </div>

  <div class="subpanel">
    <h2>Xendit (Invoices & PH/ID Payments)</h2>
    <p class="muted">Enter your Secret Key from Xendit Dashboard.</p>
    <form method="POST" action="/admin/settings/xendit">
      <label class="field" style="flex:0 0 130px;"><span>Enabled</span><input type="checkbox" name="xendit_enabled" <%= s.xendit_enabled === '1' ? 'checked' : '' %>></label>
      <label class="field"><span>Secret Key (xnd_...)</span><input type="text" name="xendit_secret_key" value="<%= escapeHtml(s.xendit_secret_key) %>"></label>
      <label class="field"><span>Callback Verification Token</span><input type="text" name="xendit_callback_token" value="<%= escapeHtml(s.xendit_callback_token) %>"></label>
      <button class="btn btn-primary" type="submit">Save Xendit configuration</button>
    </form>
    <div class="alert alert-ok" style="margin-top:14px; font-size: 11px;">
      <strong>Webhook URL:</strong> <code><%= baseUrl %>/webhooks/xendit</code>
    </div>
  </div>

  <div class="subpanel">
    <h2>Swiftpay PH (Hosted Checkout)</h2>
    <p class="muted">Enable Swiftpay PH and provide your API credentials. Leave API Base URL empty to use the default host for the selected mode.</p>
    <form method="POST" action="/admin/settings/swiftpay">
      <div class="field-row">
        <label class="field" style="flex:0 0 130px;"><span>Enabled</span><input type="checkbox" name="swiftpay_enabled" <%= s.swiftpay_enabled === '1' ? 'checked' : '' %>></label>
        <label class="field"><span>Mode</span>
          <select name="swiftpay_mode">
            <option value="sandbox" <%= s.swiftpay_mode !== 'live' ? 'selected' : '' %>>Sandbox</option>
            <option value="live" <%= s.swiftpay_mode === 'live' ? 'selected' : '' %>>Live (production)</option>
          </select>
        </label>
      </div>
      <label class="field"><span>API Base URL (optional)</span><input type="text" name="swiftpay_api_base_url" value="<%= escapeHtml(s.swiftpay_api_base_url) %>" placeholder="https://api.swiftpay.ph"></label>
      <label class="field"><span>API Key / Access Key</span><input type="text" name="swiftpay_api_key" value="<%= escapeHtml(s.swiftpay_api_key) %>"></label>
      <label class="field"><span>API Secret (optional header, or Secret Key alias)</span><input type="text" name="swiftpay_api_secret" value="<%= escapeHtml(s.swiftpay_api_secret) %>"></label>
      <label class="field"><span>Webhook Secret (optional HMAC)</span><input type="text" name="swiftpay_webhook_secret" value="<%= escapeHtml(s.swiftpay_webhook_secret) %>"></label>
      <button class="btn btn-primary" type="submit">Save Swiftpay PH configuration</button>
    </form>
    <div class="alert alert-ok" style="margin-top:14px; font-size: 11px;">
      <strong>Webhook URL:</strong> <code><%= baseUrl %>/webhooks/swiftpay</code>
    </div>
  </div>

  <div class="subpanel">
    <h2>Magpie (Alipay / WeChat Pay)</h2>
    <p class="muted">Enable Magpie for Alipay and WeChat Pay. The app will auto-convert your order amount into the target currency before creating the checkout.</p>
    <form method="POST" action="/admin/settings/magpie">
      <label class="field" style="flex:0 0 130px;"><span>Enabled</span><input type="checkbox" name="magpie_enabled" <%= s.magpie_enabled === '1' ? 'checked' : '' %>></label>
      <label class="field"><span>API Base URL (optional)</span><input type="text" name="magpie_api_base_url" value="<%= escapeHtml(s.magpie_api_base_url) %>" placeholder="https://api.magpie.example"></label>
      <label class="field"><span>API Key (or Secret Key)</span><input type="text" name="magpie_api_key" value="<%= escapeHtml(s.magpie_api_key) %>"></label>
      <label class="field"><span>API Secret (optional, can store Publishable Key)</span><input type="text" name="magpie_api_secret" value="<%= escapeHtml(s.magpie_api_secret) %>"></label>
      <label class="field"><span>Webhook Secret (optional)</span><input type="text" name="magpie_webhook_secret" value="<%= escapeHtml(s.magpie_webhook_secret) %>"></label>
      <label class="field"><span>Target Currency</span><input type="text" name="magpie_target_currency" value="<%= escapeHtml(s.magpie_target_currency) %>" placeholder="CNY"></label>
      <button class="btn btn-primary" type="submit">Save Magpie configuration</button>
    </form>
    <div class="alert alert-ok" style="margin-top:14px; font-size: 11px;">
      <strong>Webhook URL:</strong> <code><%= baseUrl %>/webhooks/magpie</code>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
