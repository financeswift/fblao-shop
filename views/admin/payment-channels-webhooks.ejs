<%- include('partials/head', { title }) %>

<div class="container mt-5">
  <div class="row mb-4">
    <div class="col-md-12">
      <h1>🔌 Webhook Logs</h1>
      <p class="text-muted">Incoming webhook notifications from payment channels</p>
    </div>
  </div>

  <% if (flash && flash.message) { %>
    <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %>">
      <%= flash.message %>
    </div>
  <% } %>

  <!-- Filter by Product -->
  <div class="row mb-4">
    <div class="col-md-12">
      <form method="GET" class="form-inline">
        <div class="form-group me-2">
          <label for="product" class="me-2">Filter by Channel:</label>
          <select class="form-control" id="product" name="product">
            <option value="">All Channels</option>
            <% allProducts.forEach(p => { %>
              <option value="<%= p.id %>" <%= productId === p.id ? 'selected' : '' %>>
                <%= p.name %>
              </option>
            <% }); %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/admin/payment-channels/webhooks" class="btn btn-secondary ms-2">Clear</a>
      </form>
    </div>
  </div>

  <!-- Channel Statistics -->
  <% if (stats.length > 0) { %>
    <div class="row mb-4">
      <% stats.forEach(stat => { %>
        <div class="col-md-6 mb-3">
          <div class="card">
            <div class="card-body">
              <h6 class="card-title"><%= stat.channel_name %></h6>
              <div class="row">
                <div class="col">
                  <small class="text-muted">Webhooks</small><br>
                  <strong><%= stat.total_webhooks %></strong>
                </div>
                <div class="col">
                  <small class="text-muted">Successful</small><br>
                  <span class="badge bg-success"><%= stat.successful %></span>
                </div>
                <div class="col">
                  <small class="text-muted">Failed</small><br>
                  <span class="badge bg-danger"><%= stat.failed %></span>
                </div>
                <div class="col">
                  <small class="text-muted">Active Days</small><br>
                  <strong><%= stat.days_active %></strong>
                </div>
              </div>
              <% if (stat.last_webhook) { %>
                <small class="text-muted">Last: <%= new Date(stat.last_webhook).toLocaleString() %></small>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Webhook Logs Table -->
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            Webhook Events
            <span class="badge bg-secondary float-end">Showing <%= logs.length %> of <%= totalLogs %></span>
          </h5>
        </div>
        <div class="card-body">
          <% if (logs.length === 0) { %>
            <div class="alert alert-info">
              <% if (productId) { %>
                No webhooks recorded for this channel.
              <% } else { %>
                No webhooks recorded yet.
              <% } %>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm table-hover" style="font-size: 0.875rem;">
                <thead>
                  <tr>
                    <th>Channel</th>
                    <th>Event Type</th>
                    <th>Status</th>
                    <th>Received</th>
                    <th>Payload</th>
                    <th>Response</th>
                  </tr>
                </thead>
                <tbody>
                  <% logs.forEach(log => { %>
                    <tr>
                      <td><strong><%= log.channel_name %></strong></td>
                      <td>
                        <span class="badge bg-info"><%= log.event_type %></span>
                      </td>
                      <td>
                        <span class="badge bg-<%= log.response_status === 200 ? 'success' : 'danger' %>">
                          <%= log.response_status || 'pending' %>
                        </span>
                      </td>
                      <td>
                        <small><%= new Date(log.received_at).toLocaleString() %></small>
                      </td>
                      <td>
                        <details>
                          <summary style="cursor: pointer;">View payload</summary>
                          <pre style="background: #f5f5f5; padding: 10px; border-radius: 4px; margin-top: 10px; max-height: 200px; overflow-y: auto; font-size: 0.75rem;"><%= log.payload %></pre>
                        </details>
                      </td>
                      <td>
                        <% if (log.response_message) { %>
                          <small><code><%= log.response_message.substring(0, 30) %>...</code></small>
                        <% } else { %>
                          <span class="text-muted">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <!-- Pagination -->
            <% if (totalLogs > limit) { %>
              <nav class="mt-3">
                <ul class="pagination justify-content-center">
                  <% if (offset > 0) { %>
                    <li class="page-item">
                      <a class="page-link" href="/admin/payment-channels/webhooks?offset=<%= Math.max(0, offset - limit) %><%= productId ? '&product=' + productId : '' %>">Previous</a>
                    </li>
                  <% } %>
                  <li class="page-item disabled">
                    <span class="page-link">Page <%= Math.floor(offset / limit) + 1 %> of <%= Math.ceil(totalLogs / limit) %></span>
                  </li>
                  <% if (offset + limit < totalLogs) { %>
                    <li class="page-item">
                      <a class="page-link" href="/admin/payment-channels/webhooks?offset=<%= offset + limit %><%= productId ? '&product=' + productId : '' %>">Next</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation Buttons -->
  <div class="row mt-4">
    <div class="col-md-12">
      <a href="/admin/payment-channels" class="btn btn-outline-primary">← Back to Payment Channels</a>
      <a href="/admin/payment-channels/analytics" class="btn btn-outline-info">View Analytics</a>
      <a href="/admin/payment-channels/history" class="btn btn-outline-warning">View Connection History</a>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
