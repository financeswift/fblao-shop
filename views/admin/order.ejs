<%- include('partials/head') %>
<div class="admin-bar" style="margin-bottom: 25px;">
  <div style="display: flex; align-items: center; gap: 15px;">
    <a class="btn btn-sm" href="/admin" style="background: var(--panel-2);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg></a>
    <h1 style="margin:0; font-size: 1.5rem;">Order <%= order.order_number %></h1>
    <span class="status-pill status-<%= order.status %>" style="margin:0;"><%= order.status %></span>
  </div>
  <div class="muted" style="font-size: 13px;">Placed on <%= date(order.created_at) %></div>
</div>

<div class="panel-grid">
  <div class="stack" style="gap: 20px;">
    <div class="subpanel">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h2 style="margin:0;">Customer Details</h2>
        <div style="display: flex; gap: 8px;">
           <button class="btn btn-sm" onclick="copyVal('@<%= order.telegram_username %>', 'TG', this)">Copy @</button>
           <a href="https://t.me/<%= order.telegram_username %>" target="_blank" class="btn btn-sm" style="background: #0088cc; color: white;">Open TG</a>
        </div>
      </div>
      <table class="kv">
        <tr><th>Telegram</th><td><strong style="color: var(--accent);">@<%= order.telegram_username %></strong></td></tr>
        <% if (order.email) { %>
          <tr>
            <th>Email</th>
            <td>
              <%= order.email %>
              <button class="btn btn-sm" style="padding: 2px 6px; font-size: 10px; margin-left: 5px;" onclick="copyVal('<%= order.email %>', 'Email', this)">Copy</button>
            </td>
          </tr>
        <% } %>
        <tr>
          <th>Payment</th>
          <td>
            <div class="payment-inline">
              <% var icon = getIcon(order.payment_type) || (manualMethod ? getIcon(manualMethod.name, manualMethod.icon_url) : null); %>
              <% if (icon) { %>
                <img class="payment-inline-logo" src="<%= icon %>" alt="Icon">
              <% } %>
              <span style="text-transform: uppercase; font-size: 12px; font-weight: bold;"><%= order.payment_type %></span>
              <%= manualMethod ? ' — ' + manualMethod.name : '' %>
            </div>
          </td>
        </tr>
        <tr>
          <th>Maya ID</th>
          <td class="muted" style="font-size: 11px;">
            <%= order.maya_checkout_id || '—' %>
            <% if (order.maya_checkout_id) { %>
              <button class="btn btn-sm" style="padding: 2px 6px; font-size: 10px; margin-left: 5px;" onclick="copyVal('<%= order.maya_checkout_id %>', 'Maya ID', this)">Copy</button>
            <% } %>
          </td>
        </tr>
        <% if (order.sim_type_selected) { %>
          <tr>
            <th>SIM Type</th>
            <td>
              <span style="display: inline-block; padding: 4px 10px; background: var(--accent-2); color: white; border-radius: 4px; font-size: 12px; font-weight: 600;">
                <%= order.sim_type_selected === 'eSIM' ? '📱 eSIM (Digital)' : '🎫 Physical SIM' %>
              </span>
            </td>
          </tr>
        <% } %>
        <% if (order.delivery_address) { %>
          <tr>
            <th>Delivery Address</th>
            <td style="max-width: 300px; word-break: break-word;">
              <code style="font-size: 11px; background: var(--panel-2); padding: 6px 8px; border-radius: 4px; display: block; line-height: 1.4;">
                <%= order.delivery_address %>
              </code>
              <button class="btn btn-sm" style="padding: 2px 6px; font-size: 10px; margin-top: 4px;" onclick="copyVal('<%= order.delivery_address %>', 'Address', this)">Copy</button>
            </td>
          </tr>
        <% } %>
      </table>
    </div>

    <% if (typeof poolItems !== 'undefined' && poolItems.length > 0) { %>
      <div class="subpanel">
        <h2>Auto-Delivered Items</h2>
        <div class="stack" style="gap: 12px;">
          <% poolItems.forEach(function(item, idx) { %>
            <div style="background: var(--panel-2); border: 1px solid var(--border); padding: 12px; border-radius: 6px;">
              <% if (item.account_email_number) { %>
                <!-- Structured Account Data -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 10px;">
                  <div>
                    <span class="muted" style="font-size: 10px; text-transform: uppercase;">Email/Number</span>
                    <div style="font-weight: 600; font-family: monospace; font-size: 12px; margin-top: 2px;"><%= item.account_email_number %></div>
                  </div>
                  <div>
                    <span class="muted" style="font-size: 10px; text-transform: uppercase;">Password</span>
                    <div style="font-weight: 600; font-family: monospace; font-size: 12px; margin-top: 2px;"><%= item.account_password %></div>
                  </div>
                  <div>
                    <span class="muted" style="font-size: 10px; text-transform: uppercase;">SIM Type</span>
                    <div style="margin-top: 4px;">
                      <span style="display: inline-block; padding: 3px 8px; background: <%= item.sim_type === 'eSIM' ? '#7c3aed' : '#3b82f6' %>; color: white; border-radius: 3px; font-size: 11px; font-weight: 600;">
                        <%= item.sim_type === 'eSIM' ? '📱 eSIM' : '🎫 SIM Card' %>
                      </span>
                    </div>
                  </div>
                  <div style="display: flex; gap: 6px;">
                    <button class="btn btn-sm" style="padding: 2px 8px; font-size: 10px; flex: 1;" onclick="copyAccountData('<%= encodeURIComponent(item.account_email_number) %>', '<%= encodeURIComponent(item.account_password) %>', this)">Copy Creds</button>
                  </div>
                </div>
                
                <!-- eSIM QR Code Display -->
                <% if (item.sim_type === 'eSIM' && item.esim_qrcode) { %>
                  <div style="border-top: 1px solid var(--border); padding-top: 12px; margin-top: 10px;">
                    <span class="muted" style="font-size: 10px; text-transform: uppercase; display: block; margin-bottom: 8px; font-weight: 700;">eSIM QR Code</span>
                    <div style="display: flex; gap: 12px; align-items: flex-start; flex-wrap: wrap;">
                      <img src="data:image/png;base64,<%= item.esim_qrcode %>" alt="eSIM QR Code" style="max-width: 120px; width: 100%; height: auto; border: 2px solid var(--border); border-radius: 8px; background: white; padding: 6px;">
                      <div style="flex: 1; min-width: 140px;">
                        <small class="muted" style="display:block; line-height:1.5;">This QR code is attached to the stock item and must be shown to the buyer after delivery.</small>
                        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:8px;">
                          <button type="button" class="btn btn-sm" style="padding: 3px 8px; font-size: 10px;" onclick="downloadQRCode('<%= item.esim_qrcode %>', 'esim-qr-<%= idx %>.png')">Download QR</button>
                          <button type="button" class="btn btn-sm" style="padding: 3px 8px; font-size: 10px;" onclick="window.open('data:image/png;base64,<%= item.esim_qrcode %>', '_blank')">Open</button>
                        </div>
                      </div>
                    </div>
                  </div>
                <% } %>
              <% } else { %>
                <!-- Legacy Plain Text Content -->
                <code style="font-size: 11px; color: var(--accent-2); display: block; white-space: pre-wrap; word-break: break-word; background: var(--panel); padding: 8px; border-radius: 4px; margin-bottom: 8px;"><%= item.content %></code>
                <button class="btn btn-sm" style="padding: 2px 8px; font-size: 10px;" onclick="copyVal('<%= item.content %>', 'Item', this)">Copy</button>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (typeof customerHistory !== 'undefined' && customerHistory.length > 0) { %>
      <div class="subpanel">
        <h2>Customer History (Last 5)</h2>
        <div class="stack" style="gap: 5px;">
          <% customerHistory.forEach(function(h) { %>
            <a href="/admin/orders/<%= h.id %>" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); padding: 6px 10px; border-radius: 6px; text-decoration: none; border: 1px solid transparent;" onmouseover="this.style.borderColor='var(--border)'" onmouseout="this.style.borderColor='transparent'">
              <span style="font-size: 13px; font-weight: 600;">#<%= h.order_number %></span>
              <span class="status-pill status-<%= h.status %>" style="min-width: 65px; font-size: 9px; padding: 2px 6px; margin:0;"><%= h.status %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="subpanel">
      <h2>Transaction Info</h2>
      <table class="kv">
        <tr><th>Product</th><td><%= order.product_name %></td></tr>
        <tr><th>Quantity</th><td><%= order.quantity %></td></tr>
        <tr><th>Unit Price</th><td><%= money(order.unit_price) %></td></tr>
        <tr><th>Total Amount</th><td><strong style="color: var(--accent-2); font-size: 1.1rem;"><%= money(order.total) %></strong></td></tr>
        <tr><th>Paid At</th><td><%= order.paid_at ? date(order.paid_at) : 'Not yet' %></td></tr>
        <tr><th>Delivered At</th><td><%= order.delivered_at ? date(order.delivered_at) : 'Not yet' %></td></tr>
      </table>

      <div class="row-actions" style="margin-top:20px; padding-top: 15px; border-top: 1px solid var(--border);">
        <% if (order.status === 'pending') { %>
          <form class="inline-form" method="POST" action="/admin/orders/<%= order.id %>/mark-paid">
            <button class="btn btn-primary btn-sm" type="submit">Confirm Payment</button>
          </form>
          <form class="inline-form" method="POST" action="/admin/orders/<%= order.id %>/cancel">
            <button class="btn btn-danger btn-sm" type="submit">Cancel Order</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="subpanel">
      <h2>Internal Admin Notes</h2>
      <form method="POST" action="/admin/orders/<%= order.id %>/notes" class="stack">
        <textarea name="admin_notes" placeholder="Private notes for staff only..." style="min-height: 80px;"><%= order.admin_notes || '' %></textarea>
        <button class="btn btn-sm" type="submit">Save Notes</button>
      </form>
    </div>
  </div>

  <div class="stack" style="gap: 20px;">
    <div class="subpanel" style="border-top: 3px solid var(--accent);">
      <h2>Edit Order Data (Public)</h2>
      <p class="muted" style="font-size: 12px; margin-bottom: 15px;">Information entered here is visible to the customer on the Order Status page.</p>
      <form method="POST" action="/admin/orders/<%= order.id %>/update-details" class="stack" style="gap: 12px;">
        <label class="field"><span>Manual Status Overide</span>
          <select name="status">
            <% ['pending','paid','delivered','failed','cancelled'].forEach(function(s){ %>
              <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s.toUpperCase() %></option>
            <% }) %>
          </select></label>

        <label class="field"><span>Account Product Name</span>
          <input type="text" name="acc_ordered" value="<%= order.acc_ordered || order.product_name %>"></label>

        <div class="field-row">
            <label class="field"><span>Account Number / ID</span>
              <input type="text" name="acc_number" value="<%= order.acc_number || '' %>"></label>
            <label class="field"><span>Account Display Name</span>
              <input type="text" name="acc_name" value="<%= order.acc_name || '' %>"></label>
        </div>

        <div class="field-row">
            <label class="field"><span>Acc Username</span>
              <input type="text" name="acc_username" value="<%= order.acc_username || '' %>"></label>
            <label class="field"><span>Acc Password</span>
              <input type="text" name="acc_password" value="<%= order.acc_password || '' %>"></label>
        </div>

        <label class="field"><span>Warranty Details</span>
          <input type="text" name="warranty_period" value="<%= order.warranty_period || '' %>" placeholder="e.g. 7 Days Replacement"></label>

        <button class="btn btn-primary btn-block" type="submit">Save Details to Status Page</button>
      </form>
    </div>

    <div class="subpanel">
      <h2>Full Credentials / Delivery Content</h2>
      <% if (order.status === 'pending') { %>
        <div class="alert alert-error" style="margin-bottom: 15px;">Warning: This order is UNPAID.</div>
      <% } %>
      <form method="POST" action="/admin/orders/<%= order.id %>/deliver" class="stack">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span class="muted" style="font-size: 13px;">Delivery Content (Plain Text / JSON / Cookies)</span>
          <% if (order.delivered_content) { %>
            <button type="button" class="btn btn-sm" style="padding: 2px 8px; font-size: 11px;" onclick="copyVal(this.form.delivered_content.value, 'Content', this)">Copy All</button>
          <% } %>
        </div>
        <textarea name="delivered_content" rows="6" placeholder="Paste full access details here..." style="font-family: monospace; font-size: 12px;"><%= order.delivered_content || '' %></textarea>
        <button class="btn btn-primary" type="submit" style="margin-top: 10px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            <%= order.status === 'delivered' ? 'Update Credentials' : 'Send to Customer' %>
        </button>
      </form>
      <% if (order.status === 'delivered') { %>
        <div class="alert alert-ok" style="margin-top:12px; font-size: 12px;">Items delivered. Customer can retrieve them via Order Status.</div>
      <% } %>
    </div>
  </div>
</div>

<script>
function copyVal(val, label, btn) {
  if (navigator.clipboard) {
    navigator.clipboard.writeText(val).then(() => {
      const oldText = btn.innerText;
      btn.innerText = 'Copied!';
      btn.style.color = 'var(--green)';
      setTimeout(() => {
        btn.innerText = oldText;
        btn.style.color = '';
      }, 1500);
    });
  } else {
    alert('Clipboard not supported');
  }
}

function copyAccountData(email, password, btn) {
  const text = `Email/Number: ${decodeURIComponent(email)}\nPassword: ${decodeURIComponent(password)}`;
  
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(() => {
      const oldText = btn.innerText;
      btn.innerText = 'Copied!';
      btn.style.color = 'var(--green)';
      setTimeout(() => {
        btn.innerText = oldText;
        btn.style.color = '';
      }, 1500);
    });
  } else {
    alert('Clipboard not supported');
  }
}

function downloadQRCode(base64Data, filename) {
  const link = document.createElement('a');
  link.href = 'data:image/png;base64,' + base64Data;
  link.download = filename || 'esim-qr.png';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}
</script>
<%- include('partials/foot') %>
