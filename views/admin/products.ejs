<%- include('partials/head') %>
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
  <h1 style="margin:0;">Products</h1>
  <div style="display: flex; gap: 10px;">
    <form method="POST" action="/admin/products/sync-all" style="margin:0;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm" type="submit" style="background: var(--panel-2); color: var(--muted); border: 1px solid var(--border);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
        Sync All Stock
      </button>
    </form>
    <button class="btn btn-sm btn-primary" onclick="document.getElementById('add-product-panel').scrollIntoView({behavior:'smooth'})">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Add Product
    </button>
  </div>
</div>

<div class="admin-bar" style="background: var(--panel); padding: 15px; border-radius: var(--radius); border: 1px solid var(--border); margin-bottom: 25px; display: flex; align-items: center; gap: 15px;">
  <form method="GET" action="/admin/products" style="display:flex; gap:10px; flex-grow: 1;">
    <div style="position: relative; flex-grow: 1; max-width: 400px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--muted);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by name or description..." style="padding:8px 12px 8px 32px; border:1px solid var(--border); border-radius:6px; background: var(--panel-2); color: var(--text); width: 100%;">
    </div>
    <select name="category_id" style="padding:8px 12px; border:1px solid var(--border); border-radius:6px; background: var(--panel-2); color: var(--text); width: 200px;">
      <option value="">All Categories</option>
      <% categories.forEach(function(c){ %>
        <option value="<%= c.id %>" <%= catFilter === c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-sm btn-primary">Filter</button>
    <% if (search || catFilter) { %>
      <a href="/admin/products" class="btn btn-sm" style="background:var(--panel-2);color:var(--muted);">Clear</a>
    <% } %>
  </form>
</div>

<div class="table-wrap" style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: 30px;">
  <table class="product-table">
    <thead>
      <tr>
        <th style="width: 50px;">ID</th>
        <th>Product Info</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Status</th>
        <th style="text-align: right;">Action</th>
      </tr>
    </thead>
    <tbody>
      <% if (!products.length) { %>
        <tr><td colspan="7" class="muted" style="text-align: center; padding: 40px;">No products found.</td></tr>
      <% } %>
      <% products.forEach(function(p){ %>
        <tr>
          <td class="muted">#<%= p.id %></td>
          <td>
            <div style="font-weight: 700; color: var(--text);"><%= p.name %></div>
            <div class="muted" style="font-size: 11px;"><%= p.description || 'No description' %></div>
          </td>
          <td>
            <span style="font-size: 13px; font-weight: 500;"><%= p.category_name || 'Uncategorized' %></span>
          </td>
          <td>
            <div style="color: var(--accent-2); font-weight: 700;"><%= money(p.price) %></div>
          </td>
          <td>
            <div style="display: flex; align-items: center; gap: 8px;">
              <strong style="font-size: 14px; <%= p.stock <= 5 ? 'color: var(--red);' : 'color: var(--green);' %>"><%= p.stock %></strong>
              <% if (p.auto_deliver) { %>
                <a href="/admin/products/<%= p.id %>/stock" class="btn btn-sm" style="padding: 2px 6px; font-size: 10px; background: rgba(212, 175, 55, 0.1); color: var(--accent); border-color: var(--accent); white-space: nowrap;">📦 Pool</a>
              <% } %>
            </div>
          </td>
          <td>
            <span class="status-pill <%= p.active ? 'status-paid' : 'status-failed' %>" style="font-size: 9px; padding: 2px 8px; min-width: 60px;">
              <%= p.active ? 'ACTIVE' : 'INACTIVE' %>
            </span>
          </td>
          <td style="text-align: right;">
            <div style="display: flex; gap: 5px; justify-content: flex-end;">
              <button class="btn btn-sm" onclick="this.closest('tr').nextElementSibling.style.display = this.closest('tr').nextElementSibling.style.display === 'none' ? 'table-row' : 'none'" style="padding: 4px 10px;">Edit</button>
              <form method="POST" action="/admin/products/<%= p.id %>/duplicate" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm" type="submit" style="padding: 4px 10px;" title="Duplicate">Copy</button>
              </form>
              <form method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?');" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-danger" type="submit" style="padding: 4px 10px;">&times;</button>
              </form>
            </div>
          </td>
        </tr>
        <tr style="display: none; background: var(--panel-2);">
          <td colspan="7" style="padding: 20px;">
            <form method="POST" action="/admin/products/<%= p.id %>/update">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <%- include('partials/product-form', { product: p, categories: categories, isNew: false, escapeHtml: escapeHtml }) %>
              <div style="display: flex; gap: 10px; align-items: center; margin-top: 15px;">
                <button class="btn btn-sm btn-primary" type="submit">Update Product</button>
                <button type="button" class="btn btn-sm" onclick="this.closest('tr').style.display = 'none'">Cancel</button>
              </div>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div id="add-product-panel" class="subpanel" style="margin-top: 40px; border-top: 4px solid var(--accent); padding: 25px;">
  <h2 style="font-size: 1.2rem; color: var(--text); margin-bottom: 20px;">Add New Product</h2>
  <% if (!categories.length) { %>
    <div class="empty-state" style="padding: 20px;">
      Create a <a href="/admin/categories" style="font-weight: 700;">category</a> first before adding products.
    </div>
  <% } else { %>
  <form method="POST" action="/admin/products">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('partials/product-form', { product: { category_id: null, name: '', description: '', price: 0, min_quantity: 1, stock: 0, sort_order: 0, auto_deliver: true, active: true, is_rentable: false, rental_1day_price: 0, rental_7day_price: 0, rental_30day_price: 0 }, categories: categories, isNew: true, escapeHtml: escapeHtml }) %>
    <button class="btn btn-primary" type="submit" style="margin-top: 15px; padding: 12px 30px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Add Product to Shop
    </button>
  </form>
  <% } %>
</div>
<%- include('partials/foot') %>
