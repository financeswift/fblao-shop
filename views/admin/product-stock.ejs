<%- include('partials/head') %>
<div style="margin-bottom: 20px;">
  <a href="/admin/products" class="btn btn-sm">&larr; Back to Products</a>
</div>

<h1>Manage Stock: <%= product.name %></h1>

<div class="subpanel" style="margin-bottom: 25px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
    <h2 style="margin:0;">Add Stock Items</h2>
    <div style="display: flex; gap: 10px;">
      <button class="btn btn-sm" style="background: var(--accent-2);" onclick="document.getElementById('addSingleStockModal').style.display='flex'">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:5px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Single Item
      </button>
      <a href="/admin/products/<%= product.id %>/stock/download-template" class="btn btn-sm" style="background: var(--panel-2);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Download CSV Template
      </a>
    </div>
  </div>

  <div class="panel-grid" style="grid-template-columns: 1fr 1fr; gap: 20px;">
    <form method="POST" action="/admin/products/<%= product.id %>/stock/add" class="stack">
      <span class="muted" style="font-size: 13px; margin-bottom: 8px;">Option 1: Paste multiple lines</span>
      <textarea name="lines" style="width:100%; min-height:120px; font-family:monospace; margin-bottom:10px; font-size: 12px;" placeholder="item1:pass
item2:pass
item3:pass"></textarea>
      <button class="btn btn-primary" type="submit">Import from Text</button>
    </form>

    <form method="POST" action="/admin/products/<%= product.id %>/stock/add" enctype="multipart/form-data" class="stack" style="border-left: 1px solid var(--border); padding-left: 20px;">
      <span class="muted" style="font-size: 13px; margin-bottom: 8px;">Option 2: Upload CSV file</span>
      <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 2px dashed var(--border); border-radius: 8px; padding: 20px; background: rgba(255,255,255,0.02);">
        <input type="file" name="csv_file" accept=".csv,.txt" id="csv_file" style="display: none;" onchange="document.getElementById('file-name').innerText = this.files[0].name">
        <label for="csv_file" class="btn btn-sm" style="margin-bottom: 10px; cursor: pointer;">Choose File</label>
        <div id="file-name" class="muted" style="font-size: 11px;">No file selected</div>
      </div>
      <button class="btn btn-primary" type="submit" style="margin-top: 10px;">Upload & Import CSV</button>
    </form>
  </div>
</div>

<div class="field-row" style="align-items: flex-start; gap: 20px;">
  <div class="subpanel" style="flex: 1; border-top: 3px solid var(--green);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
      <h2 style="margin:0;">Available Stock (<%= pool.length %>)</h2>
    </div>
    <div style="max-height: 500px; overflow-y: auto; background: rgba(0,0,0,0.2); border-radius: 8px; border: 1px solid var(--border);">
      <% if (!pool.length) { %>
        <div style="padding: 30px; text-align: center;" class="muted">No items in pool.</div>
      <% } else { %>
        <table class="product-table" style="font-size: 13px;">
          <thead style="position: sticky; top: 0; z-index: 1;">
            <% if (pool.some(item => item.account_email_number)) { %>
              <tr><th>Email/Number</th><th>Type</th><th>Password</th><th style="width: 40px;"></th></tr>
            <% } else { %>
              <tr><th>Content</th><th style="width: 40px;"></th></tr>
            <% } %>
          </thead>
          <tbody>
            <% pool.forEach(function(item){ %>
              <tr>
                <% if (item.account_email_number) { %>
                  <td style="font-family:monospace; word-break: break-all;"><%= item.account_email_number %></td>
                  <td><span style="padding: 2px 6px; background: var(--accent-2); border-radius: 3px; font-size: 11px; font-weight: 600;"><%= item.sim_type || 'SIM' %></span></td>
                  <td style="font-family:monospace; word-break: break-all;"><%= item.account_password %></td>
                  <td><button class="btn btn-sm" style="padding: 2px 6px; font-size: 11px;" onclick="copyAccountDetails('<%= encodeURIComponent(item.account_email_number) %>', '<%= encodeURIComponent(item.account_password) %>', this)">Copy</button></td>
                <% } else { %>
                  <td style="font-family:monospace; word-break: break-all;"><%= item.content %></td>
                  <td><button class="btn btn-sm" style="padding: 2px 6px;" onclick="copyVal('<%= item.content %>', 'Item', this)">Copy</button></td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <% if (pool.length) { %>
      <form method="POST" action="/admin/products/<%= product.id %>/stock/clear" onsubmit="return confirm('Clear ALL unsold stock for this product?');" style="margin-top:15px;">
        <button class="btn btn-sm btn-danger" type="submit">Delete All Unsold Stock</button>
      </form>
    <% } %>
  </div>

  <div class="subpanel" style="flex: 1; border-top: 3px solid var(--muted);">
    <h2 style="margin-bottom: 15px;">Sold / Delivered History</h2>
    <div style="max-height: 500px; overflow-y: auto; background: rgba(0,0,0,0.1); border-radius: 8px; border: 1px solid var(--border);">
      <% if (!sold.length) { %>
        <div style="padding: 30px; text-align: center;" class="muted">No items sold yet.</div>
      <% } else { %>
        <table class="product-table" style="font-size: 12px;">
          <thead style="position: sticky; top: 0; z-index: 1;">
            <tr><th>Content</th><th style="width: 100px;">Order</th></tr>
          </thead>
          <tbody>
            <% sold.forEach(function(item){ %>
              <tr>
                <td style="font-family:monospace; color: var(--muted); word-break: break-all;"><%= item.content %></td>
                <td><a href="/admin/orders/<%= item.order_id %>" style="font-weight: bold; color: var(--accent-2);">#<%= item.order_number %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal for adding single stock item -->
<div id="addSingleStockModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; overflow-y: auto; padding: 20px 0;">
  <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 30px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); margin: auto;">
    <h2 style="margin-top: 0; margin-bottom: 20px;">Add Single Account to Pool</h2>
    <p class="muted" style="font-size: 13px; margin-bottom: 20px;">Fill in the account details for this item. Each submission adds +1 to stock.</p>
    
    <form id="singleStockForm" method="POST" action="/admin/products/<%= product.id %>/stock/add-single" style="display: flex; flex-direction: column; gap: 15px;">
      
      <!-- Account Email/Number -->
      <div>
        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text);">Account Email or Number</label>
        <input type="text" name="account_email_number" placeholder="e.g., user@email.com or 09XXXXXXXXX" required style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; background: var(--panel);">
      </div>

      <!-- Account Password -->
      <div>
        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text);">Account Password</label>
        <input type="text" name="account_password" placeholder="Enter password" required style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; background: var(--panel);">
      </div>

      <!-- SIM Type Selector -->
      <div>
        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text);">SIM Type</label>
        <select name="sim_type" id="simTypeSelect" required style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; background: var(--panel); cursor: pointer;">
          <option value="">-- Select SIM Type --</option>
          <option value="SIM">SIM Card (Physical - Requires Delivery Address at Checkout)</option>
          <option value="eSIM">eSIM (Digital - QR Code Required)</option>
        </select>
      </div>

      <!-- eSIM QR Code (Conditional) -->
      <div id="esimQrCodeField" style="display: none;">
        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text);">eSIM QR Code</label>
        <p class="muted" style="font-size: 11px; margin-bottom: 10px;">Upload QR code image or paste base64 string</p>
        <div style="display: flex; gap: 10px; margin-bottom: 10px;">
          <input type="file" name="esim_qrcode_file" id="esimQrcodeFile" accept="image/*" style="flex: 1; padding: 8px; border: 1px solid var(--border); border-radius: 6px; font-size: 12px; background: var(--panel);">
          <button type="button" style="padding: 8px 15px; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; cursor: pointer; font-size: 12px;" onclick="document.getElementById('esimQrcodeFile').click()">Browse</button>
        </div>
        <textarea name="esim_qrcode_base64" id="esimQrcodeBase64" placeholder="Or paste base64 QR code here..." style="width: 100%; min-height: 60px; font-family: monospace; font-size: 11px; padding: 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); resize: vertical;"></textarea>
        <span class="muted" style="font-size: 11px; margin-top: 5px; display: block;">QR code will be shown to buyer upon delivery.</span>
      </div>
      
      <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 10px;">
        <button type="button" class="btn" style="background: var(--panel);" onclick="closeAddStockModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Item (+1)</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/foot') %>

<script>
function copyVal(val, label, btn) {
  if (navigator.clipboard) {
    navigator.clipboard.writeText(val).then(() => {
      const oldText = btn.innerText;
      btn.innerText = 'Copied!';
      btn.style.color = 'var(--green)';
      setTimeout(() => {
        btn.innerText = oldText;
        btn.style.color = '';
      }, 1500);
    });
  } else {
    alert('Clipboard not supported');
  }
}

function copyAccountDetails(email, password, btn) {
  const email_decoded = decodeURIComponent(email);
  const password_decoded = decodeURIComponent(password);
  const text = `Email/Number: ${email_decoded}\nPassword: ${password_decoded}`;
  
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(() => {
      const oldText = btn.innerText;
      btn.innerText = 'Copied!';
      btn.style.color = 'var(--green)';
      setTimeout(() => {
        btn.innerText = oldText;
        btn.style.color = '';
      }, 1500);
    });
  } else {
    alert('Clipboard not supported');
  }
}

function closeAddStockModal() {
  document.getElementById('addSingleStockModal').style.display = 'none';
}

// Handle SIM type change - show/hide eSIM QR code field
document.getElementById('simTypeSelect').addEventListener('change', function() {
  const esimField = document.getElementById('esimQrCodeField');
  const esimQrcodeBase64 = document.getElementById('esimQrcodeBase64');
  
  if (this.value === 'eSIM') {
    esimField.style.display = 'block';
    esimQrcodeBase64.setAttribute('required', 'required');
  } else {
    esimField.style.display = 'none';
    esimQrcodeBase64.removeAttribute('required');
    esimQrcodeBase64.value = '';
    document.getElementById('esimQrcodeFile').value = '';
  }
});

// Handle file upload for eSIM QR code
document.getElementById('esimQrcodeFile').addEventListener('change', function(e) {
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(event) {
      const base64 = event.target.result.split(',')[1] || event.target.result;
      document.getElementById('esimQrcodeBase64').value = base64;
    };
    reader.readAsDataURL(file);
  }
});

// Close modal when clicking outside
document.getElementById('addSingleStockModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeAddStockModal();
  }
});

// Form validation and submission
document.getElementById('singleStockForm').addEventListener('submit', function(e) {
  const simType = document.getElementById('simTypeSelect').value;
  
  if (!simType) {
    e.preventDefault();
    alert('Please select a SIM type');
    return false;
  }
  
  if (simType === 'eSIM') {
    const qrcodeBase64 = document.getElementById('esimQrcodeBase64').value.trim();
    if (!qrcodeBase64) {
      e.preventDefault();
      alert('Please provide an eSIM QR code (upload image or paste base64)');
      return false;
    }
  }
  
  // Form will submit normally
});
</script>
