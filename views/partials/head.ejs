<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= shopName %></title>
  <% if (settings.cf_site_verification) { %>
    <meta name="cloudflare-site-verification" content="<%= settings.cf_site_verification.replace('cloudflare-site-verification=', '') %>">
  <% } %>
  <link rel="stylesheet" href="/static/css/style.css">
  <% if (settings.cf_turnstile_site_key) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
</head>
<body data-currency="<%= currency %>">
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img id="siteLogo" src="/logo.png" alt="<%= escapeHtml(shopName || 'Lion King') %>" style="height: 40px; margin-right: 10px; border-radius: 4px;">
      <span class="brand-text"><%= shopName %></span>
    </a>

    <button class="menu-toggle" id="menuToggle" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>

    <nav class="main-nav" id="mainNav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        Shop / 商店
      </a>
      <a href="/status" class="<%= currentPath === '/status' || currentPath === '/swiftpay/status' || currentPath === '/swiftpay/checkout' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Order Status / 订单查询
      </a>
      <% if (user) { %>
        <a href="/account" class="<%= currentPath === '/account' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          My Account / 我的订单
        </a>
      <% } %>
      <a href="/admin" class="nav-admin">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Admin
      </a>

      <% if (user) { %>
        <div class="user-profile">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
            <% if (user.photo_url) { %>
              <img src="<%= user.photo_url %>" alt="Profile" class="user-avatar">
            <% } %>
            <span class="user-name" style="font-weight: bold; color: var(--text);">@<%= user.username %></span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <a href="https://t.me/BMXTORE" target="_blank" class="btn btn-sm btn-primary" style="background: #0088cc; color: white; width: 100%;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
              Telegram Support / 电报客服
            </a>
            <a href="/logout" class="nav-logout" style="font-size: 0.85em; color: var(--muted); text-align: center; margin-top: 5px;">Logout</a>
          </div>
        </div>
      <% } else if (settings.telegram_bot_username) { %>
        <p class="tg-login-hint">Login to track your orders</p>
        <div class="tg-login">
          <script async src="https://telegram.org/js/telegram-widget.js?22"
            data-telegram-login="<%= settings.telegram_bot_username %>"
            data-size="medium"
            data-userpic="false"
            data-auth-url="/auth/telegram"
            data-request-access="write"></script>
        </div>
      <% } %>
    </nav>
  </div>
  <% if (typeof shopTagline !== 'undefined' && shopTagline) { %>
    <div class="tagline"><div class="container"><%= shopTagline %></div></div>
  <% } %>
</header>
<div class="nav-backdrop" id="navBackdrop"></div>
<main class="container page">
