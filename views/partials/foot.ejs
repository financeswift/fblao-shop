</main>
<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <img src="/logo.png" alt="<%= escapeHtml(shopName) %>" loading="lazy">
    </div>

    <!-- BlackHorse text with shining gold effect -->
    <div class="footer-horse">
      <span class="shining-gold horse-tagline">BlackHorse</span>
    </div>

    <!-- 支付方式 (User Uploaded) -->
    <% if (footerMethods.length > 0) { %>
    <div class="footer-icon-group">
      <span class="footer-icon-label">支付方式</span>
      <div class="payment-methods">
        <% footerMethods.forEach(function(m){ %>
          <img class="payment-icon" src="<%= m.icon_url %>" alt="<%= escapeHtml(m.name) %>" title="<%= escapeHtml(m.name) %>">
        <% }) %>
      </div>
    </div>
    <% } %>
    <!-- Partner Banks & Payment Providers -->
    <div class="footer-icon-group">
      <span class="footer-icon-label">合作支付渠道</span>
      <div class="footer-partners">
        <!-- Philippine Banks -->
        <img class="footer-partner-icon" src="/static/img/footer-logos/bpi@sm.png" alt="BPI" title="BPI">
        <img class="footer-partner-icon" src="/static/img/footer-logos/bpi-family-savings-bank@sm.png" alt="BPI Family Savings Bank" title="BPI Family Savings Bank">
        <img class="footer-partner-icon" src="/static/img/footer-logos/bdo@sm.png" alt="BDO" title="BDO">
        <img class="footer-partner-icon" src="/static/img/footer-logos/metrobank@sm.png" alt="Metrobank" title="Metrobank">
        <img class="footer-partner-icon" src="/static/img/footer-logos/rcbc@sm.png" alt="RCBC" title="RCBC">
        <img class="footer-partner-icon" src="/static/img/footer-logos/union-bank-of-the-philippines@sm.png" alt="Union Bank" title="Union Bank">
        <img class="footer-partner-icon" src="/static/img/footer-logos/landbank@sm.png" alt="Landbank" title="Landbank">
        
        <!-- E-Wallets & 支付方式 -->
        <img class="footer-partner-icon" src="/static/img/footer-logos/maya-alt.png" alt="Maya" title="Maya">
        <img class="footer-partner-icon" src="/static/img/footer-logos/gcash@selection.png" alt="GCash" title="GCash">
        <img class="footer-partner-icon" src="/static/img/footer-logos/qrph.svg" alt="QRPH" title="QRPH">
        <img class="footer-partner-icon" src="/static/img/footer-logos/alipay.svg" alt="Alipay 支付宝" title="Alipay 支付宝">
        <img class="footer-partner-icon" src="/static/img/footer-logos/wechat.svg" alt="WeChat Pay 微信支付" title="WeChat Pay 微信支付">
        
        <!-- Other Banks & Services -->
        <img class="footer-partner-icon" src="/static/img/footer-logos/netbank@sm.png" alt="Netbank" title="Netbank">
        <img class="footer-partner-icon" src="/static/img/footer-logos/vbank@sm.png" alt="VBank" title="VBank">
        <img class="footer-partner-icon" src="/static/img/footer-logos/diskartech@sm.png" alt="Diskartech" title="Diskartech">
      </div>
    </div>
    <p>&copy; <%= shopName %>. All accounts are for authorized use only.</p>
    <p>Current Time (PH): <span id="live-clock" style="color: var(--accent); font-weight: bold; font-family: ui-monospace, monospace;"><%= date(new Date().toISOString()) %></span></p>
    <p>Support: <a href="https://t.me/BMXTORE" target="_blank" style="color: #0088cc; font-weight: bold;">@BMXTORE</a></p>
    <p class="muted">Simple checkout, clear pricing, and buyer-friendly payment options.</p>
    <% if (magpieEnabled) { %>
      <p class="muted">Chinese buyers: Alipay / WeChat Pay supported when available.</p>
    <% } %>
  </div>
</footer>
<script src="/static/js/main.js"></script>
</body>
</html>
